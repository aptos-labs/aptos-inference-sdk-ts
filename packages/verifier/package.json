{
  "name": "@aptos-labs/inference-verifier",
  "version": "0.1.2",
  "description": "Offline attestation verifier for the Aptos inference router.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aptos-labs/aptos-inference-sdk-ts.git",
    "directory": "packages/verifier"
  },
  "homepage": "https://github.com/aptos-labs/aptos-inference-sdk-ts/tree/main/packages/verifier#readme",
  "bugs": {
    "url": "https://github.com/aptos-labs/aptos-inference-sdk-ts/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
