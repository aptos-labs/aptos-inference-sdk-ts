{
  "name": "@aptos-labs/inference-sdk",
  "version": "0.3.0",
  "description": "Client for the Aptos confidential inference router.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aptos-labs/aptos-inference-sdk-ts.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/aptos-labs/aptos-inference-sdk-ts/tree/main/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/aptos-labs/aptos-inference-sdk-ts/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "browser": "./dist/index.browser.js",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.87",
    "@aptos-labs/inference-verifier": "workspace:*",
    "ai": "7.0.166",
    "openai": "7.54.0",
    "undici": "7.30.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
